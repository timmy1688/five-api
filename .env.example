# 只给本机后端用。docker compose up 不读这个文件，密码写在 docker-compose.yml。
# 开发时要改数据库密码，这里写成和 compose 相同的值。

# ── Initial administrator ──
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123

# ── MySQL ──
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=five_api
MYSQL_USER=five
MYSQL_PASSWORD=five_password
MYSQL_PORT=3306

# ── Redis ──
REDIS_PORT=6379

# ── Service Ports ──
# One published port serves both the admin UI and the API.
HTTP_PORT=80
