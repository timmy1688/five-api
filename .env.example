# 本机后端读根目录或 backend/ 的 .env；docker compose 只从根目录 .env 取 SECRET_KEY，其余生产配置写在 docker-compose.yml。
# 数据库密码要和 docker-compose.yml 保持一致。

# 必填，至少 32 位，部署后不能改。./service.sh install 会自动生成
SECRET_KEY=

INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=five
MYSQL_PASSWORD=five_password
MYSQL_DATABASE=five_api

REDIS_URL=redis://127.0.0.1:6379/0

# 以下是后台「系统设置」保存之前的默认值
# LOG_RETENTION_DAYS=90
# STICKY_SESSION_ENABLED=true
# STICKY_SESSION_TTL=900
# CHANNEL_HEALTH_THRESHOLD=3
# CHANNEL_HEALTH_CHECK_INTERVAL=60

# 设了才能从容器外抓 /metrics
# METRICS_TOKEN=
