# 只给本机后端用，放在项目根目录或 backend/。生产配置写在 docker-compose.yml。
# 数据库密码要和 docker-compose.yml 保持一致。

INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=five
MYSQL_PASSWORD=five_password
MYSQL_DATABASE=five_api

REDIS_URL=redis://127.0.0.1:6379/0

# 自动生成的两种独立秘密默认保存在 data/secrets.json，不入库。
# 或通过 SECRET_KEY、ENCRYPTION_KEY 配置两个互不相同的至少 32 字符随机值。
# 已有密文时不能删除/更换对应文件。升级先执行 python -m app.migrate_secrets。
# SECRETS_FILE=../data/secrets.json
# ALLOW_INSECURE_UPSTREAMS=false
# FORWARDED_ALLOW_IPS=127.0.0.1

# 以下是后台「系统设置」保存之前的默认值
# LOG_RETENTION_DAYS=90
# STICKY_SESSION_ENABLED=true
# STICKY_SESSION_TTL=900
# CHANNEL_HEALTH_THRESHOLD=3
# CHANNEL_HEALTH_CHECK_INTERVAL=60
